DATABASE_URL=postgresql+psycopg2://alert:alert@postgres:5432/alert_platform
POSTGRES_PORT=5433
GATEWAY_PORT=8080
PIPELINE_POLL_INTERVAL_S=1

# Раздел «аудит паролей» — оба значения раньше имели небезопасный
# фолбэк прямо в исходном коде ("svc123"/"dispatcher-demo-secret");
# теперь admin-console/deprovision-worker отказываются стартовать без
# них (см. docker-compose.yml).
#
# SESSION_SECRET — просто сгенерировать, ключ подписи сессионной cookie,
# не должен совпадать ни с чем в LDAP:
#   openssl rand -base64 48
#
# LDAP_SEARCH_PASSWORD — должен СОВПАДАТЬ с паролем, реально зашитым в
# passsha256 сервисного аккаунта svc-search в ldap/glauth.cfg. На чистом
# локальном стенде (свежий clone, свой glauth.cfg) — выберите пароль и
# пересчитайте хеш перед первым запуском:
#   python3 -c "import hashlib,getpass; p=getpass.getpass(); print(hashlib.sha256(p.encode()).hexdigest())"
# и замените passsha256 у пользователя svc-search в ldap/glauth.cfg на
# результат. Значение, реально работающее на демо-VM проекта, ротировано
# и хранится только в .env этой машины, не в репозитории.
SESSION_SECRET=change-me
LDAP_SEARCH_PASSWORD=change-me

# Раздел 9 — бот TrueConf. Учётная запись бота создаётся вручную через
# админ-панель (https://<TRUECONF_SERVER>/, раздел 20 п.11 — привязка
# учётной записи важна для безопасности действий через бота).
# Внутри VM бот подключается к tc_bridge напрямую по 127.0.0.1:4309 —
# это поле только для человека, открывающего админ-панель через браузер.
TRUECONF_SERVER=xn--80aebrvrg.xn--p1acf
TRUECONF_BOT_USERNAME=dispatcher_bot
TRUECONF_BOT_PASSWORD=change-me
# Логин тестового пользователя, которому бот шлёт NEW/CLOSURE (личный чат).
TRUECONF_TEST_RECIPIENT=change-me
TRUECONF_PUBLIC_CONSOLE_URL=http://localhost:8090
