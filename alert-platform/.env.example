DATABASE_URL=postgresql+psycopg2://alert:alert@postgres:5432/alert_platform
POSTGRES_PORT=5433
GATEWAY_PORT=8080
PIPELINE_POLL_INTERVAL_S=1

# Раздел 9 — бот TrueConf. Учётная запись бота создаётся вручную через
# админ-панель (https://<TRUECONF_SERVER>/, раздел 20 п.11 — привязка
# учётной записи важна для безопасности действий через бота).
# Внутри VM бот подключается к tc_bridge напрямую по 127.0.0.1:4309 —
# это поле только для человека, открывающего админ-панель через браузер.
TRUECONF_SERVER=xn--80aebrvrg.xn--p1acf
TRUECONF_BOT_USERNAME=dispatcher_bot
TRUECONF_BOT_PASSWORD=change-me
# Логин тестового пользователя, которому бот шлёт NEW/CLOSURE (личный чат).
TRUECONF_TEST_RECIPIENT=change-me
TRUECONF_PUBLIC_CONSOLE_URL=http://localhost:8090
